# Application Configuration
PROJECT_NAME="WalkJourney AI — Lyra Voice Agent"
VERSION="0.3.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Settings (JSON list format)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# =============================================
# API KEYS — SERVER-SIDE ONLY
# NEVER expose these to the frontend or commit to version control.
# =============================================

# AssemblyAI Realtime STT (Phase 2)
# Obtain from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=""

# OpenAI — LLM Tool Calling for Lyra Agent (Phase 3)
# Used ONLY on the backend for Lyra's intelligence layer.
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# OpenAI model to use for Lyra Agent tool calling.
# Recommended: gpt-4o-mini (fast, reliable, supports function calling)
# Alternatives: gpt-4o, gpt-4-turbo
LLM_MODEL="gpt-4o-mini"

# LLM request timeout in seconds (prevents hanging on slow LLM calls)
LLM_TIMEOUT_SECONDS=15

